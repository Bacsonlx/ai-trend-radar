# OpenAI API Key（主模型；需使用 OpenAI API 账户，而非桌面版 Codex 登录态）
OPENAI_API_KEY=your_openai_api_key
# 可选：主模型版本，默认为 gpt-6-astra
OPENAI_MODEL=gpt-6-astra

# Gemini API Key（OpenAI 调用失败时兜底；获取地址: https://aistudio.google.com/app/apikey）
GEMINI_API_KEY=your_gemini_api_key
# 可选：兜底使用的 Gemini 模型版本，默认为 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 飞书自定义机器人 Webhook URL
# 格式类似: https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# 可选：如果飞书机器人开启了“签名校验”，在此填写密钥；未开启则留空
FEISHU_SECRET=
